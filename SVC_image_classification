import numpy as np
import matplotlib.pyplot as plt

from sklearn.svm import SVC
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
from tensorflow.keras.datasets import mnist


# =====================================
# 1. LOAD MNIST DATASET
# =====================================

(x_train, y_train), (x_test, y_test) = mnist.load_data()

print("Original Training Shape:", x_train.shape)
print("Original Testing Shape :", x_test.shape)


# =====================================
# 2. PREPROCESS DATA
# =====================================

# Convert 28x28 images into 784 features
x_train = x_train.reshape(x_train.shape[0], 28 * 28)
x_test = x_test.reshape(x_test.shape[0], 28 * 28)

# Normalize pixel values: 0-255 -> 0-1
x_train = x_train / 255.0
x_test = x_test / 255.0

print("\nAfter Reshape:")
print("Training Shape:", x_train.shape)
print("Testing Shape :", x_test.shape)


# =====================================
# 3. TRAIN SVC MODEL
# =====================================

model = SVC(kernel="rbf")

print("\nTraining Started...")
model.fit(x_train, y_train)
print("Training Completed")


# =====================================
# 4. EVALUATE MODEL
# =====================================

y_pred = model.predict(x_test)

accuracy = accuracy_score(y_test, y_pred)

print("\nModel Accuracy:", accuracy)

print("\nClassification Report:")
print(classification_report(y_test, y_pred))

print("\nConfusion Matrix:")
print(confusion_matrix(y_test, y_pred))


# =====================================
# 5. PREDICT 4 NEW IMAGES FROM TEST DATA
# =====================================

new_images = x_test[:4]
actual_labels = y_test[:4]

new_predictions = model.predict(new_images)

print("\nPrediction on 4 Test Images:")

for i in range(4):
    print(f"Image {i + 1}")
    print("Actual Label   :", actual_labels[i])
    print("Predicted Label:", new_predictions[i])
    print("-" * 30)


# =====================================
# 6. DISPLAY 4 IMAGES WITH PREDICTIONS
# =====================================

plt.figure(figsize=(10, 4))

for i in range(4):
    img = new_images[i].reshape(28, 28)

    plt.subplot(1, 4, i + 1)
    plt.imshow(img, cmap="gray")
    plt.title(f"Actual: {actual_labels[i]}\nPred: {new_predictions[i]}")
    plt.axis("off")

plt.tight_layout()
plt.show()
